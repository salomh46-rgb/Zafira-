{
  "name": "zafira-lang",
  "displayName": "Zafira Language",
  "description": "Official syntax highlighting and language configuration for the Zafira (.zf) programming language",
  "version": "1.0.0",
  "publisher": "jasper",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/salomh46-rgb/Zafira-.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "zafira",
    "language",
    "syntax",
    "silicon-native",
    "ai"
  ],
  "contributes": {
    "languages": [
      {
        "id": "zafira",
        "aliases": [
          "Zafira",
          "zf"
        ],
        "extensions": [
          ".zf"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zafira",
        "scopeName": "source.zafira",
        "path": "./syntaxes/zafira.tmLanguage.json"
      }
    ]
  }
}
