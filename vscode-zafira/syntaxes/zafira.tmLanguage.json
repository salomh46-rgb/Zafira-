{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zafira",
  "scopeName": "source.zafira",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#hardware-directives"
    },
    {
      "include": "#function-declaration"
    },
    {
      "include": "#struct-declaration"
    },
    {
      "include": "#built-in-functions"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#built-in-types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zafira",
          "match": "//.*$"
        },
        {
          "name": "comment.block.zafira",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zafira",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.zafira",
              "match": "\\\\(?:[nrtbfv\\\\\"']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.zafira",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.zafira",
              "match": "\\\\(?:[nrtbfv\\\\\"']|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "hardware-directives": {
      "patterns": [
        {
          "name": "keyword.other.directive.zafira",
          "match": "@(gpu|npu|auto|cpu)\\b"
        }
      ]
    },
    "function-declaration": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.zafira"
            },
            "2": {
              "name": "entity.name.function.zafira"
            }
          }
        }
      ]
    },
    "struct-declaration": {
      "patterns": [
        {
          "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.zafira"
            },
            "2": {
              "name": "entity.name.type.zafira"
            }
          }
        }
      ]
    },
    "built-in-types": {
      "patterns": [
        {
          "name": "support.type.zafira",
          "match": "\\b(Int|Float|String|Bool)\\b"
        }
      ]
    },
    "built-in-functions": {
      "patterns": [
        {
          "name": "support.function.zafira",
          "match": "\\b(print|input|len|range|type)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.zafira"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zafira",
          "match": "\\b(let|const|fn|seal|draft|where|run|struct|import|return|if|else|while|for|in|and|or|not|try|catch|throw|finally)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.zafira",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.zafira",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.zafira",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.zafira",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.zafira",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "name": "constant.numeric.integer.zafira",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.zafira",
          "match": "(->|\\.\\.|==|!=|<=|>=|\\*\\*|\\+|-|\\*|/|%|<|>|=|!)"
        }
      ]
    }
  }
}
