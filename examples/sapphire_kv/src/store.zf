import std.datetime
import std.fs
import std.json
import std.string

// Kesh elementi strukturasi
struct CacheItem {
    key: String,
    value: String,
    created_at: Float,
    expires_at: Float   // 0.0 bo'lsa cheksiz (no expiry)
}

impl CacheItem {
    fn is_expired(self, current_time: Float) {
        if self.expires_at == 0.0 {
            return false
        }
        return current_time > self.expires_at
    }
}

// Asosiy Ombor (Storage Engine)
struct Store {
    items: JsonObject,
    total_ops: Int,
    hits: Int,
    misses: Int,
    aof_path: String
}

impl Store {
    fn init(self, aof_file: String) {
        self.items = json.parse("{}")
        self.total_ops = 0
        self.hits = 0
        self.misses = 0
        self.aof_path = aof_file
        
        // Haqiqiy AOF tiklash: faylni qatorma-qator o'qib, ketma-ket qayta tiklaymiz
        if fs.exists(self.aof_path) {
            let content = fs.read_text(self.aof_path)
            if content != "" {
                let lines = string.split(content, "\n")
                for line in lines {
                    let trimmed = string.trim(line)
                    if trimmed != "" {
                        try {
                            let op = json.parse(trimmed)
                            let action = op["op"]
                            let k = op["key"]
                            if action == "SET" {
                                let item = json.parse("{}")
                                item["key"] = k
                                item["val"] = op["val"]
                                item["created"] = op["created"]
                                item["exp"] = op["exp"]
                                self.items[k] = item
                            } else if action == "DEL" {
                                self.items[k] = null
                            }
                        } catch (e) {
                            // Buzilgan yoki chala qatorlarni e'tiborsiz qoldiramiz
                        }
                    }
                }
            }
        }
    }

    // Qiymatni yozish (SET) - O(1) tezlikda fayl oxiriga bitta qator qo'shadi
    fn set(self, key: String, val: String, ttl_seconds: Float) {
        self.total_ops = self.total_ops + 1
        let now = datetime.timestamp()
        let exp = 0.0
        if ttl_seconds > 0.0 {
            exp = now + ttl_seconds
        }

        let item = json.parse("{}")
        item["key"] = key
        item["val"] = val
        item["created"] = now
        item["exp"] = exp

        self.items[key] = item

        // Haqiqiy Append-Only Log yozuvi (Incremental AOF)
        let log_entry = json.parse("{}")
        log_entry["op"] = "SET"
        log_entry["key"] = key
        log_entry["val"] = val
        log_entry["created"] = now
        log_entry["exp"] = exp

        try {
            fs.append_text(self.aof_path, json.stringify(log_entry) + "\n")
        } catch (e) {
            print("[SapphireKV AOF Append Xatosi] " + String(e))
        }

        return true
    }

    // Qiymatni o'qish (GET)
    fn get(self, key: String) {
        self.total_ops = self.total_ops + 1
        
        let item = self.items[key]
        if item == null {
            self.misses = self.misses + 1
            return null
        }

        let exp = item["exp"]
        if exp > 0.0 {
            let now = datetime.timestamp()
            if now > exp {
                // Muddati o'tgan, o'chiramiz (Lazy Expiration)
                self.items[key] = null
                self.misses = self.misses + 1

                let del_entry = json.parse("{}")
                del_entry["op"] = "DEL"
                del_entry["key"] = key
                try {
                    fs.append_text(self.aof_path, json.stringify(del_entry) + "\n")
                } catch (e) {}

                return null
            }
        }

        self.hits = self.hits + 1
        return item["val"]
    }

    // Kalitni o'chirish (DEL)
    fn del(self, key: String) {
        self.total_ops = self.total_ops + 1
        if self.items[key] != null {
            self.items[key] = null

            let del_entry = json.parse("{}")
            del_entry["op"] = "DEL"
            del_entry["key"] = key
            try {
                fs.append_text(self.aof_path, json.stringify(del_entry) + "\n")
            } catch (e) {}

            return true
        }
        return false
    }

    // Kalit mavjudligini tekshirish (EXISTS)
    fn exists(self, key: String) {
        return self.get(key) != null
    }

    // AOF Rewrite / Compaction (Kompaktsiya - to'liq holatni qayta yozish)
    fn persist(self) {
        try {
            // AOF Rewrite: Faqat amaldagi aktiv kalitlarni toza holatda qayta yozamiz
            let clean_log = ""
            // Mavjud holatni AOF formatida siqib yozamiz
            fs.write_text(self.aof_path, "")
            for k in self.items {
                let it = self.items[k]
                if it != null {
                    let entry = json.parse("{}")
                    entry["op"] = "SET"
                    entry["key"] = it["key"]
                    entry["val"] = it["val"]
                    entry["created"] = it["created"]
                    entry["exp"] = it["exp"]
                    fs.append_text(self.aof_path, json.stringify(entry) + "\n")
                }
            }
        } catch (e) {
            print("[SapphireKV AOF Compaction Xatosi] " + String(e))
        }
    }

    // Statistikani hisoblash (STATS)
    fn stats(self) {
        let res = json.parse("{}")
        res["total_operations"] = self.total_ops
        res["hits"] = self.hits
        res["misses"] = self.misses
        res["engine"] = "Zafira In-Memory KV (AOF Log Engine)"
        return res
    }

    // To'liq tozalash (FLUSH)
    fn flush(self) {
        self.items = json.parse("{}")
        try {
            fs.write_text(self.aof_path, "")
        } catch (e) {}
        return true
    }
}
