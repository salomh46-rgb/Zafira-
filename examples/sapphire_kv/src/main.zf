let aof_file = "sapphire_store.aof"
let db = store_mod.Store(null, 0, 0, 0, "")
db.init(aof_file)

print("[1] Boshlang'ich testlar (In-Memory Engine):")

// 1. SET
db.set("user:101:ism", "Javohirbek", 0.0)
